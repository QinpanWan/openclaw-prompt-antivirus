{
  "name": "@entity-him/openclaw-prompt-antivirus",
  "version": "0.1.0",
  "type": "module",
  "description": "Runtime defense against prompt-injection / 'mind-virus' attacks on OpenClaw agents.",
  "dependencies": {
    "typebox": "^1.1.38"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && openclaw plugins build --entry ./dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "openclaw plugins validate --entry ./dist/index.js"
  },
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "compat": {
      "pluginApi": ">=2026.5.17",
      "minGatewayVersion": "2026.5.17"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    }
  },
  "files": ["dist", "openclaw.plugin.json", "README.md"]
}
